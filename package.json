{
  "name": "smile-nestjs-got",
  "version": "0.1.0",
  "description": "A NestJS HTTP module built on got",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spotlight21c/smile-nestjs-got.git"
  },
  "homepage": "https://github.com/spotlight21c/smile-nestjs-got#readme",
  "bugs": {
    "url": "https://github.com/spotlight21c/smile-nestjs-got/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run --config ./vitest.config.mts",
    "test:watch": "vitest --config ./vitest.config.mts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "prepare": "husky"
  },
  "keywords": [
    "nestjs",
    "got",
    "http",
    "nestjs-http",
    "rxjs",
    "esm",
    "axios"
  ],
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "got": "^14.0.0 || ^15.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.41",
    "@types/node": "^20.19.43",
    "got": "^15.0.0",
    "husky": "^9.1.7",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.0",
    "rxjs": "^7.8.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
